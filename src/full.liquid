{% assign selected_organization_id = trmnl.plugin_settings.custom_fields_values.organization_choice | default: 'oktagon' %}
{% assign selected_card = cards[selected_organization_id] %}
{% if selected_card.event %}
  {% assign organization = selected_card.organization %}
  <!--  BEGIN LOGO SETUP  -->
  {% case organization.id %}
    {% when 'ufc' %}
    {% assign organization_logo = 'data:image/svg+xml;base64,' %}
    {% when 'oktagon' %}
    {% assign organization_logo = 'data:image/png;base64,' %}
    {% when 'pfl' %}
    {% assign organization_logo = 'data:image/svg+xml;base64,' %}
    {% when 'ksw' %}
    {% assign organization_logo = 'data:image/png;base64,' %}
    {% when 'one' %}
    {% assign organization_logo = 'data:image/svg+xml;base64,' %}
  {% endcase %}
  <!--  END LOGO SETUP  -->
  {% comment %}
    Framework visibility selects compact (OG/X portrait) or wide content. Liquid only selects the content profile and its density rules.
  {% endcomment %}
  {% assign display_profiles = 'compact,wide' | split: ',' %}
  {% for display_profile in display_profiles %}
    {% capture profile_visibility %}
      {% if display_profile == 'compact' %}
        lg:hidden lg:portrait:flex
        {% else %}
        hidden lg:flex lg:portrait:hidden
      {% endif %}
    {% endcapture %}
    {% assign event = selected_card.event %}
    {% assign display_phase = selected_card.display_phase %}
    {% assign main_event = selected_card.main_event %}
    {% assign main_card = selected_card.main_card %}
    {% assign prelims = selected_card.prelims %}
    {% assign data_status = selected_card.data_status %}
    {% assign fighter_placeholder = 'https://www.ufc.com/images/styles/event_fight_card_upper_body_of_standing_athlete/s3/image/fighter_images/SHADOW_Fighter_fullLength_BLUE.png?VersionId=1Jeml9w1QwZqmMUJDg8qTrTk7fFhqUra&itok=BgqHA24D' %}
    {% capture fighter_image_onerror %}
      this.onerror=null;this.className='image image-dither w--full h--auto no-shrink';this.parentElement.classList.remove('flex--center-y','flex--bottom');this.parentElement.classList.add('flex--row','flex--top');this.src='
      {{ fighter_placeholder }}
      ';
    {% endcapture %}
    {% assign hero_portrait_fit = 'image--cover h--full w--full' %}
    {% assign portrait_frame_y = 'flex--center-y' %}
    {% if organization.id == 'oktagon' or organization.id == 'ksw' %}
      {% assign hero_portrait_fit = 'w--[18cqw] no-shrink' %}
      {% assign portrait_frame_y = 'flex--top' %}
      {% elsif organization.id == 'pfl' %}
      {% assign hero_portrait_fit = 'image--contain w--[15cqw] h--auto no-shrink' %}
      {% assign portrait_frame_y = 'flex--row flex--bottom' %}
    {% endif %}
    {% assign has_prelims = false %}
    {% unless prelims == empty %}
      {% assign has_prelims = true %}
    {% endunless %}
    {% assign undercard_rows = main_card.size | plus: 1 | divided_by: 2 %}
    {% assign undercard_row_height = 49.0 | divided_by: undercard_rows | floor %}
    {% assign hero_red_image = main_event.red.image_url %}
    {% assign hero_blue_image = main_event.blue.image_url %}
    {% if organization.id == 'ufc' %}
      {% assign hero_red_image = hero_red_image | replace: '/event_fight_card_upper_body_of_standing_athlete/', '/event_results_athlete_headshot/' | replace: '_L_', '_' | replace: '_R_', '_' | split: '?' | first %}
      {% assign hero_blue_image = hero_blue_image | replace: '/event_fight_card_upper_body_of_standing_athlete/', '/event_results_athlete_headshot/' | replace: '_L_', '_' | replace: '_R_', '_' | split: '?' | first %}
    {% endif %}
    {% assign hero_red_image = hero_red_image | default: fighter_placeholder %}
    {% assign hero_blue_image = hero_blue_image | default: fighter_placeholder %}
    {% assign hero_red_fit = hero_portrait_fit %}
    {% assign hero_blue_fit = hero_portrait_fit %}
    {% assign hero_red_frame_y = portrait_frame_y %}
    {% assign hero_blue_frame_y = portrait_frame_y %}
    {% if hero_red_image contains 'SHADOW_Fighter' %}
      {% assign hero_red_image = fighter_placeholder %}
      {% assign hero_red_fit = 'w--full h--auto no-shrink' %}
      {% assign hero_red_frame_y = 'flex--row flex--top' %}
    {% endif %}
    {% if hero_blue_image contains 'SHADOW_Fighter' %}
      {% assign hero_blue_image = fighter_placeholder %}
      {% assign hero_blue_fit = 'w--full h--auto no-shrink' %}
      {% assign hero_blue_frame_y = 'flex--row flex--top' %}
    {% endif %}
    {% assign total_count = main_card.size | plus: prelims.size | plus: 1 %}
    {% assign dense_full = false %}
    {% if display_profile == 'wide' %}
      {% comment %}
        Unclamped names need room for multiple lines; dense cards use the existing text layout earlier.
      {% endcomment %}
      {% if total_count > 20 %}
        {% assign dense_full = true %}
      {% endif %}
      {% if has_prelims %}
        {% if main_card.size > 10 or prelims.size > 10 %}
          {% assign dense_full = true %}
        {% endif %}
      {% endif %}
      {% else %}
      {% if total_count > 14 %}
        {% assign dense_full = true %}
      {% endif %}
      {% if has_prelims %}
        {% if main_card.size > 8 or prelims.size > 8 %}
          {% assign dense_full = true %}
        {% endif %}
      {% endif %}
    {% endif %}
    {% assign full_detail_type = 'lg:description--large' %}
    {% if total_count > 16 %}
      {% assign full_detail_type = '' %}
    {% endif %}
    {% if dense_full %}
      <!--  BEGIN DENSE FULL  -->
      {% assign main_card = main_card | concat: prelims %}
      {% assign total_count = main_card.size | plus: 1 %}
      {% assign split_at = total_count | plus: 1 | divided_by: 2 | floor %}
      {% assign first_column_last = split_at | minus: 1 %}
      <div class="layout {{ profile_visibility }} layout--col flex--col flex--stretch-x gap--small">
        <div class="flex flex--col gap--none no-shrink w--full">
          <span class="title title--small lg:title--base w--full" data-clamp="1">
            {{ event.name | escape }}
          </span>
          <span class="description">
            {{ event.start_at | date: '%s' | plus: trmnl.user.utc_offset | date: '%d %b · %H:%M' }}
             · 
            {{ total_count }}
             bouts
            {% if data_status.stale %}
               · STALE
            {% endif %}
          </span>
        </div>
        <div class="grid grid--cols-2 gap--small grow h--0 basis--0 w--full">
          <div class="flex flex--col flex--stretch-x gap--none h--full">
            {% assign fight = main_event %}
            {% assign use_large_labels = true %}
            {% if total_count > 20 %}
              {% assign use_large_labels = false %}
            {% endif %}
            {% assign red_name = fight.red.last_name | default: fight.red.name %}
            {% assign blue_name = fight.blue.last_name | default: fight.blue.name %}
            {% assign result_text = fight.result.method | default: fight.result.outcome | default: 'RESULT' | upcase %}
            {% assign result_code = result_text %}
            {% assign discipline_code = fight.discipline | replace: 'Muay Thai', 'MT' | replace: 'Kickboxing', 'KB' | replace: 'Grappling', 'GR' | default: 'MMA' %}
            {% if fight.result.outcome == 'no_contest' or result_text contains 'NO CONTEST' %}
              {% assign result_code = 'NC' %}
              {% elsif fight.result.outcome == 'draw' or result_text contains 'DRAW' %}
              {% assign result_code = 'DRAW' %}
              {% elsif result_text contains 'DISQUAL' or result_text == 'DQ' %}
              {% assign result_code = 'DQ' %}
              {% elsif result_text contains 'SUB' %}
              {% assign result_code = 'SUB' %}
              {% elsif result_text == 'KO' or result_text == 'TKO' %}
              {% assign result_code = result_text %}
              {% elsif result_text contains 'KO' %}
              {% assign result_code = 'KO/TKO' %}
              {% elsif result_text contains 'DEC' %}
              {% assign result_code = 'DEC' %}
            {% endif %}
            {% assign weight_code = fight.weight_class | replace: 'Light Heavyweight', 'LHW' | replace: 'Light heavyweight', 'LHW' | replace: 'Middleweight', 'MW' | replace: 'Welterweight', 'WW' | replace: 'Lightweight', 'LW' | replace: 'Featherweight', 'FW' | replace: 'Bantamweight', 'BW' | replace: 'Flyweight', 'FLW' | replace: 'Strawweight', 'SW' | replace: 'Atomweight', 'AW' | replace: 'Heavyweight', 'HW' | replace: 'Catchweight ', 'CW ' | replace: 'kg', '' | replace: ' Stand and Bang Rules', '' | replace: "Women's ", 'W ' | replace: ' Championship', '' | replace: ' Semifinal', '' | replace: ' Quarterfinal', '' | replace: ' Final', '' | split: '(' | first | split: '/' | first | strip %}
            {% assign very_long_red_type = false %}
            {% assign very_long_blue_type = false %}
            {% assign portrait_long_red_type = false %}
            {% assign portrait_long_blue_type = false %}
            {% if red_name.size > 18 %}
              {% assign very_long_red_type = true %}
            {% endif %}
            {% if blue_name.size > 18 %}
              {% assign very_long_blue_type = true %}
            {% endif %}
            {% if red_name.size > 11 %}
              {% assign portrait_long_red_type = true %}
            {% endif %}
            {% if blue_name.size > 11 %}
              {% assign portrait_long_blue_type = true %}
            {% endif %}
            {% assign larger_red_type = false %}
            {% assign larger_blue_type = false %}
            {% assign larger_detail_type = false %}
            {% if 14 >= total_count %}
              {% if 9 >= red_name.size %}
                {% assign larger_red_type = true %}
              {% endif %}
              {% if 9 >= blue_name.size %}
                {% assign larger_blue_type = true %}
              {% endif %}
            {% endif %}
            {% if 16 >= total_count %}
              {% assign larger_detail_type = true %}
            {% endif %}
            {%- capture mma_attribute_1 -%}
              grid grid--cols-12 gap--none 
              {% unless split_at == 1 %}
                border--h-5
              {% endunless %}
               px--1 lg:px--2 grow rounded--none 
              {% if fight.id == main_event.id %}
                bg--gray-75
              {% endif %}
            {% endcapture %}
            <div class="{{ mma_attribute_1 }}" data-fight-id="{{ fight.id | escape }}">
              <div class="col--span-4 flex flex--row flex--left flex--center-y gap--xsmall w--full rounded--none">
                {%- capture mma_attribute_2 -%}
                  w--5 
                  {% if fight.status == 'complete' and fight.winner_corner %}
                    lg:w--6
                    {% else %}
                    lg:w--2
                  {% endif %}
                   no-shrink flex flex--center-x flex--center-y
                {% endcapture %}
                <span class="{{ mma_attribute_2 }}">
                  {% if fight.status == 'complete' and fight.winner_corner %}
                    {%- capture mma_attribute_3 -%}
                      label label--small 
                      {% if use_large_labels %}
                        lg:label--base
                      {% endif %}
                       px--1 
                      {% if fight.winner_corner == 'red' %}
                        label--filled
                        {% else %}
                        label--outline
                      {% endif %}
                    {% endcapture %}
                    <span class="{{ mma_attribute_3 }}" data-outcome="red">
                      {% if fight.winner_corner == 'red' %}
                        W
                        {% else %}
                        L
                      {% endif %}
                    </span>
                  {% endif %}
                </span>
                {%- capture mma_attribute_4 -%}
                  label label--small 
                  {% if use_large_labels %}
                    {% if very_long_red_type %}
                      lg:label--small
                      {% elsif larger_red_type %}
                      lg:label--large lg:portrait:label--base
                      {% else %}
                      lg:label--base
                    {% endif %}
                    {% if portrait_long_red_type %}
                      lg:portrait:label--small
                    {% endif %}
                  {% endif %}
                   grow w--0 text--left 
                  {% if fight.status != 'complete' or fight.winner_corner == 'red' %}
                    font--bold
                    {% else %}
                    font--regular
                  {% endif %}
                {% endcapture %}
                <span class="{{ mma_attribute_4 }}" data-fighter-name="red">
                  {{ red_name | escape }}
                </span>
              </div>
              <div class="col--span-4 px--1 lg:px--2 w--full flex flex--center-x flex--center-y">
                {% if fight.status == 'complete' %}
                  <div class="grid grid--cols-12 gap--xsmall w--full lg:portrait:grid--cols-1 lg:portrait:gap--none">
                    {%- capture mma_attribute_5 -%}
                      col--span-5 lg:portrait:col--span-1 description 
                      {% if larger_detail_type %}
                        lg:description--large
                      {% endif %}
                       flex flex--row flex--right w--full text--right lg:portrait:flex--row.flex--center-x lg:portrait:text--center
                    {% endcapture %}
                    <span class="{{ mma_attribute_5 }}" data-result-timing data-result-text>
                      {% if fight.result.round %}
                        R
                        {{ fight.result.round }}
                      {% endif %}
                      {% if fight.result.time %}
                        {% if fight.result.round %}
                          ·
                        {% endif %}
                        {{ fight.result.time }}
                      {% endif %}
                    </span>
                    {%- capture mma_attribute_6 -%}
                      col--span-7 lg:portrait:col--span-1 description 
                      {% if larger_detail_type %}
                        lg:description--large
                      {% endif %}
                       flex flex--row flex--left w--full text--left lg:portrait:flex--row.flex--center-x lg:portrait:text--center
                    {% endcapture %}
                    <span class="{{ mma_attribute_6 }}" data-result-method data-result-text>
                      {% if selected_card.mixed_disciplines %}
                        {{ discipline_code }}
                      {% endif %}
                      {{ result_code }}
                    </span>
                  </div>
                  {% else %}
                  <span class="description lg:hidden w--full text--center" data-result-text>
                    {% if selected_card.mixed_disciplines %}
                      {{ discipline_code }}
                    {% endif %}
                    {% if fight.status == 'cancelled' %}
                      CXL
                      {% else %}
                      {{ weight_code | default: 'VS' }}
                    {% endif %}
                  </span>
                  {%- capture mma_attribute_7 -%}
                    hidden lg:block description 
                    {% if larger_detail_type %}
                      lg:description--large
                    {% endif %}
                     lg:font--regular w--full text--center
                  {% endcapture %}
                  <span class="{{ mma_attribute_7 }}" data-result-text>
                    {% if selected_card.mixed_disciplines %}
                      {{ discipline_code }}
                    {% endif %}
                    {% if fight.status == 'cancelled' %}
                      CXL
                      {% else %}
                      {{ weight_code | default: 'VS' }}
                    {% endif %}
                  </span>
                {% endif %}
              </div>
              <div class="col--span-4 flex flex--row flex--right flex--center-y gap--xsmall w--full rounded--none">
                {%- capture mma_attribute_8 -%}
                  label label--small 
                  {% if use_large_labels %}
                    {% if very_long_blue_type %}
                      lg:label--small
                      {% elsif larger_blue_type %}
                      lg:label--large lg:portrait:label--base
                      {% else %}
                      lg:label--base
                    {% endif %}
                    {% if portrait_long_blue_type %}
                      lg:portrait:label--small
                    {% endif %}
                  {% endif %}
                   grow w--0 flex flex--row text--right flex--right 
                  {% if fight.status != 'complete' or fight.winner_corner == 'blue' %}
                    font--bold
                    {% else %}
                    font--regular
                  {% endif %}
                {% endcapture %}
                <span class="{{ mma_attribute_8 }}" data-fighter-name="blue">
                  {{ blue_name | escape }}
                </span>
                {%- capture mma_attribute_9 -%}
                  w--5 
                  {% if fight.status == 'complete' and fight.winner_corner %}
                    lg:w--6
                    {% else %}
                    lg:w--2
                  {% endif %}
                   no-shrink flex flex--center-x flex--center-y
                {% endcapture %}
                <span class="{{ mma_attribute_9 }}">
                  {% if fight.status == 'complete' and fight.winner_corner %}
                    {%- capture mma_attribute_10 -%}
                      label label--small 
                      {% if use_large_labels %}
                        lg:label--base
                      {% endif %}
                       px--1 
                      {% if fight.winner_corner == 'blue' %}
                        label--filled
                        {% else %}
                        label--outline
                      {% endif %}
                    {% endcapture %}
                    <span class="{{ mma_attribute_10 }}" data-outcome="blue">
                      {% if fight.winner_corner == 'blue' %}
                        W
                        {% else %}
                        L
                      {% endif %}
                    </span>
                  {% endif %}
                </span>
              </div>
            </div>
            {% for fight in main_card %}
              {% if split_at > forloop.index %}
                {% assign use_large_labels = true %}
                {% if total_count > 20 %}
                  {% assign use_large_labels = false %}
                {% endif %}
                {% assign red_name = fight.red.last_name | default: fight.red.name %}
                {% assign blue_name = fight.blue.last_name | default: fight.blue.name %}
                {% assign result_text = fight.result.method | default: fight.result.outcome | default: 'RESULT' | upcase %}
                {% assign result_code = result_text %}
                {% assign discipline_code = fight.discipline | replace: 'Muay Thai', 'MT' | replace: 'Kickboxing', 'KB' | replace: 'Grappling', 'GR' | default: 'MMA' %}
                {% if fight.result.outcome == 'no_contest' or result_text contains 'NO CONTEST' %}
                  {% assign result_code = 'NC' %}
                  {% elsif fight.result.outcome == 'draw' or result_text contains 'DRAW' %}
                  {% assign result_code = 'DRAW' %}
                  {% elsif result_text contains 'DISQUAL' or result_text == 'DQ' %}
                  {% assign result_code = 'DQ' %}
                  {% elsif result_text contains 'SUB' %}
                  {% assign result_code = 'SUB' %}
                  {% elsif result_text == 'KO' or result_text == 'TKO' %}
                  {% assign result_code = result_text %}
                  {% elsif result_text contains 'KO' %}
                  {% assign result_code = 'KO/TKO' %}
                  {% elsif result_text contains 'DEC' %}
                  {% assign result_code = 'DEC' %}
                {% endif %}
                {% assign weight_code = fight.weight_class | replace: 'Light Heavyweight', 'LHW' | replace: 'Light heavyweight', 'LHW' | replace: 'Middleweight', 'MW' | replace: 'Welterweight', 'WW' | replace: 'Lightweight', 'LW' | replace: 'Featherweight', 'FW' | replace: 'Bantamweight', 'BW' | replace: 'Flyweight', 'FLW' | replace: 'Strawweight', 'SW' | replace: 'Atomweight', 'AW' | replace: 'Heavyweight', 'HW' | replace: 'Catchweight ', 'CW ' | replace: 'kg', '' | replace: ' Stand and Bang Rules', '' | replace: "Women's ", 'W ' | replace: ' Championship', '' | replace: ' Semifinal', '' | replace: ' Quarterfinal', '' | replace: ' Final', '' | split: '(' | first | split: '/' | first | strip %}
                {% assign very_long_red_type = false %}
                {% assign very_long_blue_type = false %}
                {% assign portrait_long_red_type = false %}
                {% assign portrait_long_blue_type = false %}
                {% if red_name.size > 18 %}
                  {% assign very_long_red_type = true %}
                {% endif %}
                {% if blue_name.size > 18 %}
                  {% assign very_long_blue_type = true %}
                {% endif %}
                {% if red_name.size > 11 %}
                  {% assign portrait_long_red_type = true %}
                {% endif %}
                {% if blue_name.size > 11 %}
                  {% assign portrait_long_blue_type = true %}
                {% endif %}
                {% assign larger_red_type = false %}
                {% assign larger_blue_type = false %}
                {% assign larger_detail_type = false %}
                {% if 14 >= total_count %}
                  {% if 9 >= red_name.size %}
                    {% assign larger_red_type = true %}
                  {% endif %}
                  {% if 9 >= blue_name.size %}
                    {% assign larger_blue_type = true %}
                  {% endif %}
                {% endif %}
                {% if 16 >= total_count %}
                  {% assign larger_detail_type = true %}
                {% endif %}
                {%- capture mma_attribute_11 -%}
                  grid grid--cols-12 gap--none 
                  {% unless forloop.index == first_column_last %}
                    border--h-5
                  {% endunless %}
                   px--1 lg:px--2 grow rounded--none 
                  {% if fight.id == main_event.id %}
                    bg--gray-75
                  {% endif %}
                {% endcapture %}
                <div class="{{ mma_attribute_11 }}" data-fight-id="{{ fight.id | escape }}">
                  <div class="col--span-4 flex flex--row flex--left flex--center-y gap--xsmall w--full rounded--none">
                    {%- capture mma_attribute_12 -%}
                      w--5 
                      {% if fight.status == 'complete' and fight.winner_corner %}
                        lg:w--6
                        {% else %}
                        lg:w--2
                      {% endif %}
                       no-shrink flex flex--center-x flex--center-y
                    {% endcapture %}
                    <span class="{{ mma_attribute_12 }}">
                      {% if fight.status == 'complete' and fight.winner_corner %}
                        {%- capture mma_attribute_13 -%}
                          label label--small 
                          {% if use_large_labels %}
                            lg:label--base
                          {% endif %}
                           px--1 
                          {% if fight.winner_corner == 'red' %}
                            label--filled
                            {% else %}
                            label--outline
                          {% endif %}
                        {% endcapture %}
                        <span class="{{ mma_attribute_13 }}" data-outcome="red">
                          {% if fight.winner_corner == 'red' %}
                            W
                            {% else %}
                            L
                          {% endif %}
                        </span>
                      {% endif %}
                    </span>
                    {%- capture mma_attribute_14 -%}
                      label label--small 
                      {% if use_large_labels %}
                        {% if very_long_red_type %}
                          lg:label--small
                          {% elsif larger_red_type %}
                          lg:label--large lg:portrait:label--base
                          {% else %}
                          lg:label--base
                        {% endif %}
                        {% if portrait_long_red_type %}
                          lg:portrait:label--small
                        {% endif %}
                      {% endif %}
                       grow w--0 text--left 
                      {% if fight.status != 'complete' or fight.winner_corner == 'red' %}
                        font--bold
                        {% else %}
                        font--regular
                      {% endif %}
                    {% endcapture %}
                    <span class="{{ mma_attribute_14 }}" data-fighter-name="red">
                      {{ red_name | escape }}
                    </span>
                  </div>
                  <div class="col--span-4 px--1 lg:px--2 w--full flex flex--center-x flex--center-y">
                    {% if fight.status == 'complete' %}
                      <div class="grid grid--cols-12 gap--xsmall w--full lg:portrait:grid--cols-1 lg:portrait:gap--none">
                        {%- capture mma_attribute_15 -%}
                          col--span-5 lg:portrait:col--span-1 description 
                          {% if larger_detail_type %}
                            lg:description--large
                          {% endif %}
                           flex flex--row flex--right w--full text--right lg:portrait:flex--row.flex--center-x lg:portrait:text--center
                        {% endcapture %}
                        <span class="{{ mma_attribute_15 }}" data-result-timing data-result-text>
                          {% if fight.result.round %}
                            R
                            {{ fight.result.round }}
                          {% endif %}
                          {% if fight.result.time %}
                            {% if fight.result.round %}
                              ·
                            {% endif %}
                            {{ fight.result.time }}
                          {% endif %}
                        </span>
                        {%- capture mma_attribute_16 -%}
                          col--span-7 lg:portrait:col--span-1 description 
                          {% if larger_detail_type %}
                            lg:description--large
                          {% endif %}
                           flex flex--row flex--left w--full text--left lg:portrait:flex--row.flex--center-x lg:portrait:text--center
                        {% endcapture %}
                        <span class="{{ mma_attribute_16 }}" data-result-method data-result-text>
                          {% if selected_card.mixed_disciplines %}
                            {{ discipline_code }}
                          {% endif %}
                          {{ result_code }}
                        </span>
                      </div>
                      {% else %}
                      <span class="description lg:hidden w--full text--center" data-result-text>
                        {% if selected_card.mixed_disciplines %}
                          {{ discipline_code }}
                        {% endif %}
                        {% if fight.status == 'cancelled' %}
                          CXL
                          {% else %}
                          {{ weight_code | default: 'VS' }}
                        {% endif %}
                      </span>
                      {%- capture mma_attribute_17 -%}
                        hidden lg:block description 
                        {% if larger_detail_type %}
                          lg:description--large
                        {% endif %}
                         lg:font--regular w--full text--center
                      {% endcapture %}
                      <span class="{{ mma_attribute_17 }}" data-result-text>
                        {% if selected_card.mixed_disciplines %}
                          {{ discipline_code }}
                        {% endif %}
                        {% if fight.status == 'cancelled' %}
                          CXL
                          {% else %}
                          {{ weight_code | default: 'VS' }}
                        {% endif %}
                      </span>
                    {% endif %}
                  </div>
                  <div class="col--span-4 flex flex--row flex--right flex--center-y gap--xsmall w--full rounded--none">
                    {%- capture mma_attribute_18 -%}
                      label label--small 
                      {% if use_large_labels %}
                        {% if very_long_blue_type %}
                          lg:label--small
                          {% elsif larger_blue_type %}
                          lg:label--large lg:portrait:label--base
                          {% else %}
                          lg:label--base
                        {% endif %}
                        {% if portrait_long_blue_type %}
                          lg:portrait:label--small
                        {% endif %}
                      {% endif %}
                       grow w--0 flex flex--row text--right flex--right 
                      {% if fight.status != 'complete' or fight.winner_corner == 'blue' %}
                        font--bold
                        {% else %}
