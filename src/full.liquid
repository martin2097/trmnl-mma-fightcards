                          {% elsif organization.id == 'oktagon' or organization.id == 'ksw' %}
                          <img class="image image-dither w--[7cqw] no-shrink" onerror="{{ fighter_image_onerror | escape }}" src="{{ fight_blue_image }}" alt="{{ fight.blue.name | escape }}">
                          {% elsif organization.id == 'pfl' %}
                          <img class="image image-dither image--contain w--full h--full" onerror="{{ fighter_image_onerror | escape }}" src="{{ fight_blue_image }}" alt="{{ fight.blue.name | escape }}">
                          {% else %}
                          <img class="image image-dither image--cover w--full h--full" onerror="{{ fighter_image_onerror | escape }}" src="{{ fight_blue_image }}" alt="{{ fight.blue.name | escape }}">
                        {% endif %}
                      </div>
                    {% endif %}
                    {% if fight.status == 'complete' and fight.winner_corner %}
                      <div class="w--6 lg:w--7 flex flex--center-x flex--center-y no-shrink">
