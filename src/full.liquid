                          h--[7cqh]
                        {% endif %}
                         lg:w--[5cqw] lg:h--[8cqh] lg:portrait:w--10 lg:portrait:h--10 no-shrink flex flex--center-x flex--top rounded--none
                      {% endcapture %}
                      <div class="{{ mma_attribute_24 }}">
                        {% if fight_red_placeholder %}
