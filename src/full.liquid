                      <span class="description {{ full_detail_type }} font--bold text--center">VS</span>
                      {% if fight.weight_class %}
                        <span class="description {{ full_detail_type }} lg:font--regular w--full text--center lg:hidden">
                          {% if selected_card.mixed_disciplines %}
                            {{ discipline_code }}
                          {% endif %}
                          {{ fight_weight_display_x }}
                        </span>
                        <span class="hidden lg:block description {{ full_detail_type }} lg:font--regular w--full text--center">
                          {% if selected_card.mixed_disciplines %}
                            {{ discipline_code }}
                          {% endif %}
                          {{ fight_weight_display_x }}
                        </span>
                      {% endif %}
                    {% endif %}
                  </div>
                  <div class="col--span-4 lg:col--span-5 lg:portrait:col--span-4 flex flex--row flex--right flex--center-y gap--xsmall rounded--none">
