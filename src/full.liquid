                {% for fight in prelims %}
                  {% assign fight_red_display_name = fight.red.last_name | default: fight.red.name %}
                  {% assign fight_blue_display_name = fight.blue.last_name | default: fight.blue.name %}
                  {% assign red_long_word = false %}
                  {% assign blue_long_word = false %}
                  {% assign red_words = fight_red_display_name | split: ' ' %}
                  {% assign blue_words = fight_blue_display_name | split: ' ' %}
                  {% for word in red_words %}
                    {% if word.size > 9 %}
                      {% assign red_long_word = true %}
                    {% endif %}
                  {% endfor %}
                  {% for word in blue_words %}
                    {% if word.size > 9 %}
                      {% assign blue_long_word = true %}
                    {% endif %}
                  {% endfor %}
                  {% assign fight_weight_display = fight.weight_class | replace: ' Stand and Bang Rules', '' | replace: 'Light Heavyweight', 'Lt Heavy' | replace: 'Light heavyweight', 'Lt Heavy' | replace: 'Catchweight ', 'CW ' | replace: 'Catchweight', 'Catch' | replace: 'kg', '' | replace: "Women's ", 'W. ' %}
                  {% assign fight_weight_display_x = fight.weight_class | replace: 'Light Heavyweight', 'LHW' | replace: 'Light heavyweight', 'LHW' | replace: 'Middleweight', 'MW' | replace: 'Welterweight', 'WW' | replace: 'Lightweight', 'LW' | replace: 'Featherweight', 'FW' | replace: 'Bantamweight', 'BW' | replace: 'Flyweight', 'FLW' | replace: 'Strawweight', 'SW' | replace: 'Atomweight', 'AW' | replace: 'Heavyweight', 'HW' | replace: 'Catchweight ', 'CW' | replace: 'kg', '' | replace: ' Stand and Bang Rules', '' | replace: "Women's ", 'W ' | replace: ' Championship', '' | replace: ' Semifinal', '' | replace: ' Quarterfinal', '' | replace: ' Final', '' | split: '(' | first | split: '/' | first | strip %}
                  {% assign fight_result_text = fight.result.method | default: fight.result.outcome | default: 'RESULT' | upcase %}
                  {% assign fight_result_code = fight_result_text %}
                  {% assign discipline_code = fight.discipline | replace: 'Muay Thai', 'MT' | replace: 'Kickboxing', 'KB' | replace: 'Grappling', 'GR' | default: 'MMA' %}
                  {% if fight.result.outcome == 'no_contest' or fight_result_text contains 'NO CONTEST' %}
                    {% assign fight_result_code = 'NC' %}
                    {% elsif fight.result.outcome == 'draw' or fight_result_text contains 'DRAW' %}
                    {% assign fight_result_code = 'DRAW' %}
                    {% elsif fight_result_text contains 'DISQUAL' or fight_result_text == 'DQ' %}
                    {% assign fight_result_code = 'DQ' %}
                    {% elsif fight_result_text contains 'SUB' %}
                    {% assign fight_result_code = 'SUB' %}
                    {% elsif fight_result_text == 'KO' or fight_result_text == 'TKO' %}
                    {% assign fight_result_code = fight_result_text %}
                    {% elsif fight_result_text contains 'KO' %}
                    {% assign fight_result_code = 'KO/TKO' %}
                    {% elsif fight_result_text contains 'DEC' %}
                    {% assign fight_result_code = 'DEC' %}
                  {% endif %}
                  {%- capture mma_attribute_29 -%}
                    grid grid--cols-10 lg:grid--cols-12 lg:portrait:grid--cols-10 gap--xsmall 
                    {% unless forloop.last %}
                      border--h-5
                    {% endunless %}
                     px--1 lg:px--2 grow w--full rounded--none
                  {% endcapture %}
