                {%- capture mma_attribute_22 -%}
                  grid grid--cols-10 lg:grid--cols-12 lg:portrait:grid--cols-10 gap--xsmall 
                  {% if full_row_border %}
                    border--h-5
                  {% endif %}
                   px--1 lg:px--2 
                  {% if has_prelims %}
                    grow
                    {% else %}
                    h--[
                    {{ undercard_row_height }}
                    cqh] lg:portrait:h--0 lg:portrait:grow lg:portrait:basis--0
                  {% endif %}
