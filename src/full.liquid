                    <div class="col--span-4 lg:col--span-5 lg:portrait:col--span-4 flex flex--row flex--left flex--center-y gap--xsmall rounded--none">
                      {% if fight.status == 'complete' and fight.winner_corner %}
                        <div class="w--6 lg:w--7 flex flex--center-x flex--center-y no-shrink">
                          {%- capture mma_attribute_30 -%}
                            label label--small lg:label--base 
                            {% if fight.winner_corner == 'red' %}
                              label--filled
                              {% else %}
                              label--outline
                            {% endif %}
                          {% endcapture %}
                          <span class="{{ mma_attribute_30 }}" data-outcome="red">
                            {% if fight.winner_corner == 'red' %}
                              W
                              {% else %}
                              L
                            {% endif %}
                          </span>
                        </div>
                      {% endif %}
                      {%- capture mma_attribute_31 -%}
                        label label--small 
                        {% if total_count > 16 or fight_red_display_name.size > 16 or red_long_word %}
                          lg:label--base
                          {% else %}
                          lg:label--large
                        {% endif %}
                        {% if 16 >= total_count and 16 >= fight_red_display_name.size %}
                          lg:portrait:label--large
                        {% endif %}
                         text--left 
                        {% if fight.status != 'complete' or fight.winner_corner == 'red' %}
                          font--bold
                          {% else %}
                          font--regular
                        {% endif %}
                         grow w--0 rounded--none
                      {% endcapture %}
                      <span class="{{ mma_attribute_31 }}" data-fighter-name="red">
                        {{ fight_red_display_name | escape }}
                      </span>
                    </div>
                    <div class="col--span-2 px--1 flex flex--col flex--center-x flex--center-y gap--none rounded--none">
                      {% if fight.status == 'complete' %}
                        <span class="description {{ full_detail_type }} font--bold text--center">
                          {% if selected_card.mixed_disciplines %}
                            {{ discipline_code }}
                          {% endif %}
                          {{ fight_result_code }}
                        </span>
                        <span class="description {{ full_detail_type }} lg:font--regular text--center" data-full-timing>
                          {% if fight.result.round %}
                            R
                            {{ fight.result.round }}
                          {% endif %}
                          {% if fight.result.time %}
                            {% if fight.result.round %}
                               · 
                            {% endif %}
                            {{ fight.result.time }}
                          {% endif %}
                        </span>
                        {% elsif fight.status == 'cancelled' %}
                        <span class="label label--small lg:label--small label--outline">CXL</span>
                        {% else %}
                        <span class="description {{ full_detail_type }} font--bold text--center">VS</span>
                        {% if fight.weight_class %}
                          <span class="description {{ full_detail_type }} lg:font--regular w--full text--center lg:hidden">
                            {% if selected_card.mixed_disciplines %}
                              {{ discipline_code }}
                            {% endif %}
                            {{ fight_weight_display_x }}
                          </span>
                          <span class="hidden lg:block description {{ full_detail_type }} lg:font--regular w--full text--center">
                            {% if selected_card.mixed_disciplines %}
                              {{ discipline_code }}
                            {% endif %}
                            {{ fight_weight_display_x }}
                          </span>
                        {% endif %}
                      {% endif %}
