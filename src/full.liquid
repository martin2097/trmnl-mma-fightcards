                          {% elsif organization.id == 'oktagon' or organization.id == 'ksw' %}
                          <img class="image image-dither w--[7cqw] no-shrink" onerror="{{ fighter_image_onerror | escape }}" src="{{ fight_red_image }}" alt="{{ fight.red.name | escape }}">
                          {% elsif organization.id == 'pfl' %}
                          <img class="image image-dither image--contain w--full h--full" onerror="{{ fighter_image_onerror | escape }}" src="{{ fight_red_image }}" alt="{{ fight.red.name | escape }}">
                          {% else %}
