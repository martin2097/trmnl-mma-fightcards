      <div class="title_bar {{ profile_visibility }}">
        <img class="image image--contain w--10 h--6" src="{{ organization_logo }}" alt>
        <span class="title">
          {{ organization.name }}
        </span>
      </div>
      <!--  END ORG FOOTER  -->
    {% endif %}
  {% endfor %}
  {% else %}
  <div class="layout layout--col">
    <span class="title">
      {{ selected_organization_id | upcase }}
