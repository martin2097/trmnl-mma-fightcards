                        label label--small 
                        {% if total_count > 16 or fight_blue_display_name.size > 16 or blue_long_word %}
                          lg:label--base
                          {% else %}
                          lg:label--large
                        {% endif %}
                        {% if 16 >= total_count and 16 >= fight_blue_display_name.size %}
                          lg:portrait:label--large
                        {% endif %}
                         flex flex--row text--right flex--right 
                        {% if fight.status != 'complete' or fight.winner_corner == 'blue' %}
                          font--bold
                          {% else %}
                          font--regular
                        {% endif %}
                         grow w--0 rounded--none
                      {% endcapture %}
                      <span class="{{ mma_attribute_32 }}" data-fighter-name="blue">
                        {{ fight_blue_display_name | escape }}
                      </span>
                      {% if fight.status == 'complete' and fight.winner_corner %}
