                            label--filled
                            {% else %}
                            label--outline
                          {% endif %}
                        {% endcapture %}
                        <span class="{{ mma_attribute_28 }}" data-outcome="blue">
                          {% if fight.winner_corner == 'blue' %}
                            W
                            {% else %}
                            L
                          {% endif %}
                        </span>
                      </div>
                    {% endif %}
                  </div>
                </div>
                {% if has_prelims == false and remaining_rows == 1 %}
                  {% comment %}
                    The last two landscape cells share a bottom row; portrait needs a separator between them. Border utilities have no responsive variants in 3.1.8, so control visibility on a zero-height border element.
                  {% endcomment %}
                  <div class="hidden lg:portrait:block border--h-5 w--full h--0 no-shrink" data-portrait-row-separator></div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
          {% if has_prelims %}
            <div class="col--span-6 flex flex--col flex--stretch-x gap--xsmall h--full rounded--none landscape:border--v-5 pl--1 lg:portrait:pl--0 lg:portrait:pt--2">
